{
  "name": "fair-queue",
  "version": "0.0.0",
  "type": "commonjs",
  "description": "A fair, queue-based rate-limiting library for Node.js and browsers that prioritizes users with shorter queues and ensures quick responsiveness for new users under high load.",
  "keywords": [
    "queue",
    "fair-queue",
    "rate-limit",
    "rate-limiting",
    "priority-queue",
    "weighted-queue",
    "load-balancing",
    "task-queue",
    "request-queue",
    "throttling",
    "typescript"
  ],
  "author": "Beeno Tung <aabbcc1241@yahoo.com.hk> (https://beeno-tung.surge.sh)",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beenotung/fair-queue.git"
  },
  "homepage": "https://github.com/beenotung/fair-queue#readme",
  "bugs": {
    "url": "https://github.com/beenotung/fair-queue/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsc --noEmit",
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc -p . && rimraf dist/tsconfig.tsbuildinfo dist/*.test.*",
    "tsc": "tsc -p ."
  },
  "devDependencies": {
    "@beenotung/tslib": "^24.6.2",
    "@types/node": "^22.14.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
